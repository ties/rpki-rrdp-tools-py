[Unit]
Description=Import rpki-client metrics and generate RRDP sync config
# Prevent rrdp-sync from running concurrently with the import
# so that rrdp-sync never reads a partially-written config file.
Before=rrdp-sync.service
Conflicts=rrdp-sync.service

[Service]
Type=oneshot
Environment=IMAGE=ghcr.io/ties/rpki-rrdp-tools-py@sha256:315882ae7cb0c82b84b83e31ef73aa6c8cc3cc5600acf00d8c7daa38ffa50698
ExecStart=/usr/bin/podman run --rm -v /var/lib/rpki-client/metrics:/metrics:ro -v /data:/data ${IMAGE} sync-rrdp import-from-metrics --base-dir /data/rrdp/ -o /data/rrdp_sync.toml /metrics
SyslogIdentifier=rrdp-import
