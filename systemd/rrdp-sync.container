[Unit]
Description=Run RRDP sync

[Container]
Image=rrdp-tools.image
LogDriver=passthrough
Exec=sync-rrdp run /data/rrdp_sync.toml --parallel-connections 64
Volume=/data:/data
ReadOnly=true
DropCapability=ALL
# Map container root to host root, container 999 (nonroot) to host 65534 (nobody)
UIDMap=0:0:999
UIDMap=999:65534:1
GIDMap=0:0:999
GIDMap=999:65534:1

[Service]
Type=oneshot
# When a repository is not working, the tool exits with a non-zero exit code.
# Restart=on-failure to make systemd reactivate the unit.
Restart=on-failure
SyslogIdentifier=rrdp-sync
NoNewPrivileges=true

ExecStopPost=/bin/sh -c '/usr/bin/journalctl -u rrdp-sync.service --invocation 0 >> /data/logs/$$(date +%%Y%%m%%d).log'
